# Runtime environment for the self-hosted (Hostinger) Node server.
# Copy to `.env` on the server — never commit the filled-in file.
#
# Values marked (public) are safe in the browser bundle and must be present at
# BUILD time. Values without the VITE_ prefix are server-only and are read at
# REQUEST time inside server functions.

# --- Backend connection (public) — needed at build time ---
VITE_SUPABASE_URL="https://YOUR-BACKEND-HOST"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"

# --- Backend connection (server-only) — needed at runtime ---
SUPABASE_URL="https://YOUR-BACKEND-HOST"
SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-KEY"
SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"

# Only required if a future server function needs privileged access.
# Leave unset otherwise — the current site does not need it.
# SUPABASE_SERVICE_ROLE_KEY=""

# --- Node server ---
PORT="3000"
HOST="127.0.0.1"
NODE_ENV="production"
