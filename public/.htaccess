# Hostinger (Apache) configuration for the prerendered static build.
# Copied verbatim into the build output; harmless on non-Apache hosts.
#
# The enforcing Content-Security-Policy is injected per page as a <meta> tag at
# build time (with SHA-256 hashes for every inline script, so no 'unsafe-inline'
# is needed). This file adds the directives a meta tag cannot express plus all
# other security, caching and firewall rules.

Options -Indexes -MultiViews
DirectoryIndex index.html
ServerSignature Off

# =====================================================================
# Firewall: request method, bad bots, exploit probes, hotlinking
# =====================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Allow only the methods a static site needs
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST|OPTIONS)$
  RewriteRule ^ - [F,L]

  # 2. Block known scrapers, vulnerability scanners and mass downloaders
  RewriteCond %{HTTP_USER_AGENT} (ahrefsbot|semrushbot|dotbot|mj12bot|blexbot|petalbot|seznambot|serpstatbot|zgrab|masscan|nmap|nikto|sqlmap|acunetix|nessus|wpscan|havij|fimap|libwww-perl|python-requests|curl/7\.(1|2|3)|httrack|wget|harvest|extractor) [NC]
  RewriteRule ^ - [F,L]

  # 3. Block empty user agents on POST (bot signature)
  RewriteCond %{REQUEST_METHOD} =POST
  RewriteCond %{HTTP_USER_AGENT} ^$
  RewriteRule ^ - [F,L]

  # 4. Block common exploit probe paths (this site is not WordPress/PHP)
  RewriteCond %{REQUEST_URI} (^|/)(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|\.env|\.git|\.svn|\.aws|vendor/phpunit|phpmyadmin|adminer\.php|shell\.php|eval-stdin\.php|config\.php\.bak) [NC]
  RewriteRule ^ - [F,L]

  # 5. Block obvious injection patterns in the query string
  RewriteCond %{QUERY_STRING} (union([^a-z]|\s)+select|base64_decode\(|<script|%3Cscript|\.\./\.\./|/etc/passwd) [NC]
  RewriteRule ^ - [F,L]

  # 6. Hotlink protection for media (allow direct hits and the university domains)
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?duet\.edu\.pk/ [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?google\.[a-z.]+/ [NC]
  RewriteCond %{REQUEST_URI} ^/media/.*\.(jpe?g|png|webp|gif|svg)$ [NC]
  RewriteRule ^ - [F,L]

  # Force HTTPS (Hostinger terminates SSL upstream, so check the forwarded proto)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Staff area lives on the app host, not on this static host
  RewriteRule ^(auth|admin)(/.*)?$ https://relic-to-render.lovable.app/$1$2 [R=302,L]

  # /about-duet -> /about-duet/index.html (clean URLs, no redirect)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]

  # Anything else that is not a real file falls back to the app shell so
  # client-side routing still resolves the page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# Never serve dotfiles, source, backups or archives
<FilesMatch "(^\.|\.(env|ini|log|sh|sql|bak|old|orig|save|swp|tmp|ts|tsx|map|zip|tar|gz|md|json5|lock)$)">
  Require all denied
</FilesMatch>
<FilesMatch "^(package(-lock)?\.json|bun\.lock|bunfig\.toml|tsconfig\.json|vite\.config\.ts|\.htaccess|\.htpasswd)$">
  Require all denied
</FilesMatch>

<IfModule mod_alias.c>
  RedirectMatch 404 /\.git
</IfModule>

# --- Compression: the single biggest win for high traffic ---
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Caching: hashed assets forever, HTML revalidated ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set X-DNS-Prefetch-Control "on"
  # Frame-ancestors and reporting cannot be set from a <meta> tag; the rest of
  # the enforcing policy (including per-page script hashes) is in the page HTML.
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header unset X-Powered-By
  Header unset Server

  # Sitemap / robots stay fresh
  <FilesMatch "(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /index.html

# --- Correct content types + ETags for conditional requests ---
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
FileETag MTime Size
